APP_NAME=Strategic Intelligence Monitor
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://strategic:strategic@postgres:5432/strategic
REDIS_URL=redis://redis:6379/0
APP_TIMEZONE=Europe/Moscow
DIGEST_HOUR_LOCAL=8
COLLECTOR_INTERVAL_MINUTES=30
RESPECT_ROBOTS=true
MAX_ARTICLES_PER_SOURCE=30
MIN_RELEVANCE_BEFORE_LLM=0.20
AI_PROVIDER=auto
OPENAI_API_KEY=
